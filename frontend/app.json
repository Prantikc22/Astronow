{
  "expo": {
    "name": "AstroNow",
    "slug": "astronow",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "astronow",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prantik.astronow"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0B1A"
      },
      "package": "com.prantik.astronow"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand/splash-mark.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B1A"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/feather",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#D979A2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
