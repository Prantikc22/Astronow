# Mobile-visible values only. Never put a Supabase service-role key or an
# OpenRouter key in this file or in any EXPO_PUBLIC_* variable.
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.10:8000
# Public mobile credentials from Supabase Project Settings > API. Never use the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Set to 1 only after Google OAuth is enabled in Supabase and redirect URLs are allowed.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=0
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_public_sdk_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_public_sdk_key
# Development-only seeded UI preview; ignored in production bundles.
EXPO_PUBLIC_PREVIEW_MODE=0
